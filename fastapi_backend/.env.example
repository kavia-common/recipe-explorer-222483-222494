# Backend configuration example
# Copy to .env and adjust as needed

# Database URL (SQLAlchemy). If not set, defaults to local postgres at localhost:5000/myapp with appuser/dbuser123.
DATABASE_URL=postgresql+psycopg2://appuser:dbuser123@localhost:5000/myapp

# Secret for token signing
SECRET_KEY=change-this-in-production
TOKEN_TTL_SECONDS=86400
PASSWORD_SALT=dev-salt

# CORS Frontend URL (e.g., http://localhost:3000). If unset, allows all origins.
FRONTEND_URL=http://localhost:3000

# Upload directory for images (relative to backend root)
UPLOAD_DIR=uploaded_images
